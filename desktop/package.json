{
  "name": "pro-calendar-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.procalendar.desktop",
    "productName": "Pro Calendar",
    "files": ["**/*"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] }
  }
}